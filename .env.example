# Salin ke .env.local lalu isi nilainya. JANGAN commit file berisi nilai asli.

# Database — Neon Postgres (connection string pooled, tambahkan sslmode=require)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Domain publik situs, tanpa trailing slash (mis. https://namadomain.com).
# Dipakai sebagai `metadataBase` untuk canonical dan hreflang. WAJIB diisi di
# produksi; di lokal fallback-nya http://localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# Auth admin — string acak >= 32 byte (mis. `openssl rand -base64 32`)
AUTH_SECRET=""
ADMIN_EMAIL=""

# Path panel admin (opsional, default `admin`). Ubah butuh redeploy karena
# dipakai juga oleh matcher statis di proxy.ts.
ADMIN_PATH=""

# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (email transaksional)
RESEND_API_KEY=""
MAIL_FROM=""

# Cloudflare Turnstile (anti-spam kontak)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
